# Long random secret used only in the owner’s dashboard settings.
OWNER_KEY=
PORT=8787
HOST=127.0.0.1
# Local MongoDB, an authenticated server, or a MongoDB Atlas connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=closer
# Docker Compose: use a random hexadecimal password.
MONGO_PASSWORD=
MONGO_ROOT_PASSWORD=
CLOSER_DOMAIN=closer.example.com
